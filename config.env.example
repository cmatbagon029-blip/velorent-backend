# Cloud Storage Configuration
STORAGE_TYPE=s3

# Database Configuration
DB_HOST=localhost
DB_NAME=velorent
DB_USER=root
DB_PASS=

# Application Configuration
APP_URL=http://localhost/VelorentAdmin
IONIC_APP_URL=http://localhost:8100
DEBUG_MODE=true
S3_BUCKET=velorent-company-files
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_BASE_URL=https://velorent-company-files.s3.ap-southeast-2.amazonaws.com

# PayMongo Configuration (TEST MODE)
# Test API keys - for testing payments with GCash, GrabPay, PayMaya
# Switch to live keys (sk_live_/pk_live_) for production
PAYMONGO_SECRET_KEY=sk_test_your_test_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_test_public_key_here
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret_here
